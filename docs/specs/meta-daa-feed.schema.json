{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://saas-auto-catalogo.github.io/schemas/meta-daa-feed.schema.json",
  "title": "MetaDaaFeedEntry",
  "description": "Schema de validação formal para os itens exportados no feed Meta Automotive Inventory Ads (DAA)",
  "type": "object",
  "required": [
    "vehicle_id",
    "title",
    "description",
    "url",
    "image_link",
    "price",
    "availability",
    "make",
    "model",
    "year",
    "mileage_value",
    "mileage_unit",
    "vin",
    "state_of_vehicle"
  ],
  "properties": {
    "vehicle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_\\-\\.:]+$",
      "description": "Identificador único estável do veículo sem espaços"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 150,
      "description": "Título formatado do anúncio"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 5000,
      "description": "Descrição sanitizada do veículo sem tags HTML"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "description": "URL direta para o anúncio no site da revenda em HTTPS"
    },
    "image_link": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "description": "URL da foto principal em alta resolução em HTTPS"
    },
    "additional_image_links": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "description": "Lista de fotos secundárias em HTTPS"
    },
    "price": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{2})? BRL$",
      "description": "Preço numérico seguido de espaço e BRL (ex: 489700.00 BRL)"
    },
    "sale_price": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{2})? BRL$",
      "description": "Preço promocional se houver (ex: 469000.00 BRL)"
    },
    "availability": {
      "type": "string",
      "enum": ["in stock", "out of stock", "available for order"]
    },
    "make": {
      "type": "string",
      "minLength": 1,
      "description": "Marca do fabricante"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Modelo principal"
    },
    "year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100,
      "description": "Ano do modelo do veículo"
    },
    "mileage_value": {
      "type": "integer",
      "minimum": 0,
      "description": "Quilometragem rodada"
    },
    "mileage_unit": {
      "type": "string",
      "enum": ["KM"],
      "default": "KM"
    },
    "vin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "description": "Chassi do veículo ou identificador único alternativo"
    },
    "state_of_vehicle": {
      "type": "string",
      "enum": ["new", "used", "cpo"]
    },
    "body_style": {
      "type": "string",
      "enum": [
        "convertible",
        "coupe",
        "hatchback",
        "minivan",
        "pickup",
        "sedan",
        "suv",
        "van",
        "wagon",
        "other"
      ]
    },
    "transmission": {
      "type": "string",
      "enum": ["automatic", "manual", "other"]
    },
    "fuel_type": {
      "type": "string",
      "enum": [
        "diesel",
        "electric",
        "flex",
        "gasoline",
        "hybrid",
        "plugin_hybrid",
        "other"
      ]
    },
    "exterior_color": {
      "type": "string"
    },
    "interior_color": {
      "type": "string"
    },
    "doors": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "drivetrain": {
      "type": "string",
      "enum": ["4wd", "awd", "fwd", "rwd"]
    },
    "dealer_id": {
      "type": "string"
    },
    "dealer_name": {
      "type": "string"
    },
    "dealer_phone": {
      "type": "string"
    },
    "fb_page_id": {
      "type": "string"
    },
    "custom_label_0": {
      "type": "string"
    },
    "custom_label_1": {
      "type": "string"
    },
    "custom_label_2": {
      "type": "string"
    },
    "custom_label_3": {
      "type": "string"
    },
    "custom_label_4": {
      "type": "string"
    }
  }
}
